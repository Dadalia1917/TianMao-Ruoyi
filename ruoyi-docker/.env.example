# 复制为 ruoyi-docker/.env 后再填写。此文件中的示例值不能用于生产。

# 有域名时只填域名，例如 voice.example.com，Caddy 会自动申请 HTTPS。
# 尚无域名、只做 HTTP 联调时使用 http://:80；公网麦克风需要有效 HTTPS。
PUBLIC_DOMAIN=http://:80
HTTP_PORT=80
HTTPS_PORT=443

# 必填密钥。建议至少 32 位随机字符，且三项不要相同。
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD
MYSQL_APP_USER=tmall_app
MYSQL_APP_PASSWORD=CHANGE_ME_APPLICATION_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
TOKEN_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS

# 阿里云百炼，仅保存在服务器 ruoyi-docker/.env。
DASHSCOPE_API_KEY=sk-CHANGE_ME
DASHSCOPE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_MODEL=qwen3.5-omni-plus-realtime
DASHSCOPE_VOICE=Ethan
REALTIME_VAD_THRESHOLD=0.5
REALTIME_VAD_PREFIX_PADDING_MS=500
REALTIME_VAD_SILENCE_DURATION_MS=800
REALTIME_ECHO_GUARD_SECONDS=3
# T10S Android 客户端本机 ContentProvider 控制链路。
GENIE_PROVIDER_ENABLED=true
GENIE_PROVIDER_RESULT_TIMEOUT_SECONDS=8
# 附近设备声学中继实验默认关闭。
ACOUSTIC_RELAY_ENABLED=false
ACOUSTIC_RELAY_WAKE_PHRASE=天猫精灵

# 家庭智能 Agent（与实时语音共用 DASHSCOPE_API_KEY）。
AGENT_ENABLED=true
AGENT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AGENT_MODEL=qwen3.8-max
AGENT_TIMEOUT_SECONDS=15
AGENT_MAX_TOOL_ROUNDS=3
AGENT_LOCATION_NAME=无锡
AGENT_LATITUDE=31.4912
AGENT_LONGITUDE=120.3119
AGENT_TIMEZONE=Asia/Shanghai
AGENT_WEATHER_ENABLED=true
AGENT_SIMULATED_ENVIRONMENT_ENABLED=true
AGENT_HOUSEHOLD_STATE_TTL_SECONDS=300
AGENT_DEFAULT_ROOM=客厅
AGENT_STATE_REDIS_DB=1

# 长期记忆提取 API。
MEMORY_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
MEMORY_MODEL=qwen-plus

# 纯文字对话 API 与全部已接入模型。
TEXT_CHAT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL_QWEN38=qwen3.8-max
TEXT_MODEL_QWEN37=qwen3.7-plus-2026-05-26
TEXT_MODEL_QWEN37_FLASH=qwen3.7-flash-2026-07-15
TEXT_MODEL_DEEPSEEK=deepseek-v4-flash-0731
TEXT_MODEL_DEEPSEEK_PRO=deepseek-v4-pro
TEXT_MODEL_DEEPSEEK_R1=deepseek-r1-0528

# 单台 2 vCPU / 8 GiB ECS 推荐起始值；业务增长后再提升 CPU 或横向扩容。
JAVA_OPTS=-Xms256m -Xmx768m -XX:MaxMetaspaceSize=256m -Dfile.encoding=UTF-8
FASTAPI_WORKERS=2
MAX_CONNECTIONS=150
MAX_CONNECTIONS_PER_USER=3
MYSQL_MAX_CONNECTIONS=150
MYSQL_POOL_MIN_SIZE=2
MYSQL_POOL_MAX_SIZE=10

# 隐私默认值。
VOICE_STORE_TRANSCRIPTS=false
MEMORY_ENABLED=true
TEXT_CHAT_ENABLED=true

# 设置域名后建议改成 https://你的域名；多个来源用英文逗号分隔。
ALLOWED_ORIGINS=*

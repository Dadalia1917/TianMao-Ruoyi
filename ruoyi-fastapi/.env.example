# 千问百炼 API Key（必填）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 兼容用户给出的旧版公网地址；新业务空间建议填写带 WorkspaceId 的地址：
# wss://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_MODEL=qwen3.5-omni-plus-realtime
DASHSCOPE_VOICE=Ethan

# 服务监听
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info
ALLOWED_ORIGINS=*

# 每个进程的连接保护。生产环境多进程时，总上限约等于 workers * MAX_CONNECTIONS。
MAX_CONNECTIONS=300
MAX_CONNECTIONS_PER_USER=3
# 百炼单次实时会话最多120分钟；提前5分钟轮换，由客户端自动续接。
UPSTREAM_ROTATE_SECONDS=6900
CLIENT_EVENT_MAX_BYTES=262144
CLIENT_QUEUE_SIZE=256

# 语音服务通过若依 /getInfo 校验账号；APP 首次登录后携带本地 Token。
RUOYI_AUTH_URL=http://127.0.0.1:8080/getInfo
RUOYI_AUTH_CACHE_SECONDS=60

# MySQL 会话持久化。长期记忆开启时必须为 true。
DATABASE_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ry-cat
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_POOL_MIN_SIZE=2
MYSQL_POOL_MAX_SIZE=20
DATABASE_QUEUE_SIZE=10000
DATABASE_WORKERS=2
# 语音文字包含隐私，只有明确需要历史记录时才开启
VOICE_STORE_TRANSCRIPTS=false

# 账号长期记忆：对话结束后用文本模型提取稳定偏好/事实，下次会话自动注入。
MEMORY_ENABLED=true
MEMORY_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
MEMORY_MODEL=qwen-plus
MEMORY_CACHE_SECONDS=300
MEMORY_MAX_ITEMS=50
MEMORY_QUEUE_SIZE=2000
MEMORY_WORKERS=2
MEMORY_EXTRACTION_MAX_CHARS=16000

# 次要功能：纯文字对话（支持键盘或前端语音输入）。模型 ID 可按百炼账号实际开放范围替换。
TEXT_CHAT_ENABLED=true
TEXT_CHAT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL_QWEN38=qwen3.8-max
TEXT_MODEL_QWEN37=qwen3.7-plus-2026-05-26
TEXT_MODEL_QWEN37_FLASH=qwen3.7-flash-2026-07-15
TEXT_MODEL_DEEPSEEK=deepseek-v4-flash-0731
TEXT_MODEL_DEEPSEEK_PRO=deepseek-v4-pro
TEXT_MODEL_DEEPSEEK_R1=deepseek-r1-0528
TEXT_MAX_CONNECTIONS=100
TEXT_MAX_CONNECTIONS_PER_USER=3
TEXT_REQUEST_MAX_BYTES=524288
TEXT_MAX_MESSAGES=30
TEXT_MAX_CHARS=60000
TEXT_TIMEOUT_SECONDS=240
